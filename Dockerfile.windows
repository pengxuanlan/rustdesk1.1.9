# RustDesk Windows Cross-Compilation Docker Image
# 使用方法: docker build -t rustdesk-win-builder -f Dockerfile.windows .
#              docker run --rm -v $(pwd):/workspace rustdesk-win-builder

FROM debian:bullseye

WORKDIR /workspace

# 安装基础工具和Windows交叉编译工具链
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    curl \
    wget \
    cmake \
    ninja-build \
    nasm \
    yasm \
    pkg-config \
    mingw-w64 \
    clang \
    && rm -rf /var/lib/apt/lists/*

# 安装Rust和Windows交叉编译目标
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs > rustup.sh && \
    chmod +x rustup.sh && \
    ./rustup.sh -y && \
    rm rustup.sh

# 设置Rust环境
ENV HOME=/root
ENV PATH="/root/.cargo/bin:${PATH}"
ENV CARGO_HOME=/root/.cargo
ENV RUSTUP_HOME=/root/.rustup

# 添加Windows交叉编译目标
RUN rustup target add x86_64-pc-windows-gnu && \
    rustup target add x86_64-pc-windows-msvc

# 预安装必要的Windows库（可选，使用系统库）
# 如果需要静态链接，需要安装mingw-w64的Windows库

# 设置默认的交叉编译目标
RUN echo '[target.x86_64-pc-windows-gnu]' >> /root/.cargo/config.toml && \
    echo 'linker = "x86_64-w64-mingw32-gcc"' >> /root/.cargo/config.toml && \
    echo 'rustflags = ["-C", "target-feature=+crt-static"]' >> /root/.cargo/config.toml

# 工作目录
WORKDIR /workspace

# 默认命令
CMD ["/bin/bash"]
